# Optional free API keys. The app works without these (yfinance is the primary source);
# they are only used for enrichment / fallback on top candidates.
# Copy this file to ".env" and fill in whichever you have.

# Financial Modeling Prep — free tier ~250 requests/day: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Finnhub — free tier 60 requests/min (20-min delayed): https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Contact email used in the SEC EDGAR User-Agent header (fair-use requirement).
SEC_USER_AGENT_EMAIL=
